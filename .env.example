# ===== Supabase (Settings → API) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx        # NUNCA expor no cliente
SUPABASE_JWT_SECRET=xxxx                # "JWT Secret" — usado p/ assinar a sessão (RLS)

# ===== Segurança =====
# Gerar com: openssl rand -hex 32
NWC_ENCRYPTION_KEY=xxxx                 # cifra as strings NWC no banco

# ===== LNbits (mutinynet) =====
LNBITS_URL=https://SEU-LNBITS
LNBITS_ADMIN_KEY=xxxx                   # só no servidor

# ===== Agentes (FastAPI da dupla) =====
AGENTS_API_URL=http://localhost:8000
