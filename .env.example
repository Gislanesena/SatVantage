# ===== Supabase (Settings → API) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx        # NUNCA expor no cliente
SUPABASE_JWT_SECRET=xxxx                # "JWT Secret" — usado p/ assinar a sessão (RLS)

# ===== Segurança =====
# Gerar com: openssl rand -hex 32
NWC_ENCRYPTION_KEY=xxxx                 # cifra as strings NWC no banco

# ===== LNbits (mutinynet) =====
LNBITS_URL=https://SEU-LNBITS
LNBITS_ADMIN_KEY=xxxx                   # só no servidor

# ===== Agentes (FastAPI — só no servidor Next; o browser usa /api/agents) =====
# agents-api local (se 8000 estiver ocupada, use 8001)
AGENTS_API_URL=http://127.0.0.1:8001

RESEND_API_KEY=xxxx
CRON_SECRET=xxxx

# ===== Copiloto (visão / Anthropic) — opcional =====
# Se AGENTS_API_URL não tiver /extension/analisar-imagem, usa a API Anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===== Herança (prova de vida + e-mail) =====
# URL pública do app (links de check-in e documento)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
# APP_URL=https://seu-dominio.com
#
# Resend (https://resend.com) — plano gratuito, API via fetch
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=SatVantage <onboarding@resend.dev>
#
# Segredo do cron (header x-cron-secret). Roda a cada 5 min na Vercel.
# Demo: 30 min sem check-in → e-mail de prova de vida; +20 min → avisa herdeiros.
# CRON_SECRET=gerar-com-openssl-rand-hex-32
# Local: curl -X POST http://localhost:3000/api/heranca/verificar-inatividade -H "x-cron-secret: SEU_SECRET"
#
# Chave Nostr de serviço do SatVantage (nsec) — só para DM NIP-04 opcional aos herdeiros
# Nunca logar nem gravar no banco. Gerar um par uma vez e guardar só no .env
# SATVANTAGE_SERVICE_NSEC=nsec1...
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
