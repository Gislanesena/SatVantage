{
  "manifest_version": 3,
  "name": "SatVantage Copiloto",
  "version": "0.5.0",
  "description": "Side Panel: domínio oficial, análise Bitcoin/segurança, captura, cotação BTC e mapa do site SatVantage.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "https://sat-vantage-gislanesena.vercel.app/*",
    "https://sat-vantage-iau60jdhv-gislanesena.vercel.app/*",
    "http://localhost:3000/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SatVantage Copiloto",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
